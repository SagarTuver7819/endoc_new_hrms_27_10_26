# Fishfa Rubbers HRMS — PHP limits for large contractor ops grids + PDF uploads
Options -Indexes

<FilesMatch "(^\.env|^\.user\.ini$|^\.gitignore$|\.(md|sql|gz|log)$)">
    Require all denied
</FilesMatch>

RedirectMatch 404 /\.git(/|$)
RedirectMatch 404 ^/(fishfa_rubber/)?sql/

<IfModule mod_php.c>
    php_value max_input_vars 20000
    php_value max_input_time 120
    php_value post_max_size 64M
    php_value upload_max_filesize 32M
</IfModule>
<IfModule mod_php7.c>
    php_value max_input_vars 20000
    php_value max_input_time 120
    php_value post_max_size 64M
    php_value upload_max_filesize 32M
</IfModule>
<IfModule mod_php8.c>
    php_value max_input_vars 20000
    php_value max_input_time 120
    php_value post_max_size 64M
    php_value upload_max_filesize 32M
</IfModule>
