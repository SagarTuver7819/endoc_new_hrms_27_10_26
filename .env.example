# =====================================================
# Endoc Biotech HRMS - Environment Template
# Copy this file to ".env" and edit values.
#   Local:  copy .env.example → .env
#   Live:   copy .env.example → .env  (server pe alag values)
# NEVER commit real .env to git.
# =====================================================

# local | production
APP_ENV=local

# Full site URL (no trailing slash)
# Local XAMPP example:
APP_URL=http://localhost/endoc_new_hrms_27_10_26
# Live subdomain example:
# APP_URL=https://endoc-hrms.oceanhub.co.in

# Optional: Fixed Recruitment QR URL (phones). If empty, localhost auto-uses live URL above.
# RECRUITMENT_PUBLIC_URL=https://endoc-hrms.oceanhub.co.in/recruitment/apply.php

# URL path prefix (no trailing slash)
# Local folder under htdocs:
APP_BASE_PATH=/endoc_new_hrms_27_10_26
# Live subdomain document root = project root → leave EMPTY:
# APP_BASE_PATH=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=endoc_hrms
DB_USER=root
DB_PASS=
# Reuse pooled MySQL connections (faster Salary Register / reports). Set 0 if host shows "too many connections".
DB_PERSISTENT=1

# Optional display timezone
APP_TIMEZONE=Asia/Kolkata
